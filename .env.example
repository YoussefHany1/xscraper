# Copy to .env.local and fill in, or set these in the Vercel dashboard / GitHub
# Actions secrets. Never commit the real values.

# ---------------------------------------------------------------------------
# GitHub Actions secret (REQUIRED)
# ---------------------------------------------------------------------------
# The X login session as a Playwright storageState JSON blob.
# Produce it locally with:  npm run export-session > session.json
# Add it with:              gh secret set X_STORAGE_STATE < session.json
#
# The runner has no interactive login, so this is the only way in.
X_STORAGE_STATE=

# ---------------------------------------------------------------------------
# GitHub Actions: if x.com blocks the runner (see `npm run doctor`)
# ---------------------------------------------------------------------------
# The runner's datacenter IP is the usual reason a hosted runner gets a
# Cloudflare page. Two fixes; you need only one.
#
# 1. Run on your own machine instead. Set a repository VARIABLE (not a secret).
#    The value MUST be valid JSON -- it is parsed with fromJSON, so a plain
#    `self-hosted, windows` would become one label with that literal name:
#      gh variable set RUNS_ON --body '[self-hosted, windows]'
#    Register the runner first: https://github.com/settings/<repo>/settings/runners
#    The job then runs every 15 minutes whenever that machine is on.
#
# 2. Route the traffic through a residential proxy, so the job keeps running on
#    a hosted runner but x.com sees a normal residential address.
#      gh secret set XSCRAPER_PROXY --body 'http://user:pass@host:port'
#    socks5://host:port works too. Leave unset if the IP is not a problem.
# XSCRAPER_PROXY=

# ---------------------------------------------------------------------------
# Vercel environment variables (REQUIRED)
# ---------------------------------------------------------------------------
# Raw URL of data/tweets.json in your repo. Example for a public repo:
#   https://raw.githubusercontent.com/<owner>/<repo>/main/data/tweets.json
# meta.json is derived from this by replacing tweets.json with meta.json; set
# XSCRAPER_DATA_META_URL only if the two live in different places.
XSCRAPER_DATA_URL=

# Only needed for a PRIVATE repo. A fine-grained token with read-only Contents
# access is enough. Public repos must leave this unset.
# XSCRAPER_DATA_TOKEN=github_pat_...

# Restrict /api/tweets/<username> to a fixed set of accounts.
# Leave unset to serve any username.
# ALLOWED_ACCOUNTS=FutSheriff,FNBRintel,LeagueOfLeaks,Rainbow6Game,ValorantUpdated

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Edge Cache TTL. Must match the workflow cron (600 == */15). Raise it above
# 600 and the API can outlive the data behind it.
# XSCRAPER_CACHE_TTL_SECONDS=600

# Override config.js without redeploying.
# XSCRAPER_ACCOUNTS=nasa,github
# XSCRAPER_IGNORE_KEYWORDS=giveaway,airdrop,sponsored
# XSCRAPER_MATCH_MODE=word
# XSCRAPER_PRUNE_MAX_AGE_DAYS=14
# XSCRAPER_PRUNE_MAX_PER_ACCOUNT=500

# Force the session/browser pair. The workflow sets these already; they are
# here for unusual local setups.
#   XSCRAPER_SESSION  auto | env | profile
#   XSCRAPER_BROWSER  auto | playwright | system
# XSCRAPER_SESSION=profile
# XSCRAPER_BROWSER=system

# Local only: which installed browser the CLI drives (msedge, chrome, chromium).
# XSCRAPER_BROWSER_CHANNEL=msedge